{
    "name": "vendor/name",
    "description": "Api de miembros clicclatam",
    "require": {
        "slim/slim": "^4.12",
        "illuminate/database": "^8.83",
        "php-di/php-di": "^6.4",
        "monolog/monolog": "^2.9",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.8",
        "respect/validation": "^2.2",
        "phpmailer/phpmailer": "^6.8",
        "slim/twig-view": "^3.3",
        "phpoffice/phpspreadsheet": "^1.29",
        "vlucas/phpdotenv": "^5.6",
        "php-di/slim-bridge": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Src\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "docker-compose exec app ./vendor/bin/phpunit --colors=always",
        "test:unit": "docker-compose exec app ./vendor/bin/phpunit --testsuite 'Unit Tests' --colors=always",
        "test:integration": "docker-compose exec app ./vendor/bin/phpunit --testsuite 'Integration Tests' --colors=always",
        "test:coverage": "docker-compose exec app ./vendor/bin/phpunit --coverage-text --colors=always",
        "test:verbose": "docker-compose exec app ./vendor/bin/phpunit --testdox --colors=always"
    },
    "config": {
        "audit": {
            "abandoned": "report"
        }
    },
    "authors": [
        {
            "name": "Dacosta",
            "email": "dacostadesarrollo@gmail.com"
        }
    ]
}
